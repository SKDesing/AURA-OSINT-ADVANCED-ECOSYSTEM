doctype html
html(lang="fr")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title AURA OSINT
    style.
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: system-ui; background: #0a0a0a; color: #fff; }
      .container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
      .header { background: linear-gradient(135deg, #1a1a1a, #2a2a2a); padding: 2rem; border-radius: 8px; margin-bottom: 2rem; }
      .header h1 { color: #ffd700; font-size: 2rem; margin-bottom: 0.5rem; }
      .status { display: inline-block; padding: 0.5rem 1rem; background: #2a2a2a; border-radius: 4px; font-size: 0.9rem; }
      .status.ok { background: #1a4d1a; color: #4ade80; }
      .card { background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 2rem; margin-bottom: 1rem; }
      .btn { background: #ffd700; color: #000; border: none; padding: 0.75rem 1.5rem; border-radius: 4px; cursor: pointer; font-weight: 600; text-decoration: none; display: inline-block; }
      .btn:hover { background: #ffed4e; }
      input, select { width: 100%; padding: 0.75rem; background: #2a2a2a; border: 1px solid #444; border-radius: 4px; color: #fff; margin-bottom: 1rem; }
      .result { background: #1a1a1a; border-left: 4px solid #ffd700; padding: 1rem; margin-top: 1rem; }
      pre { background: #0a0a0a; padding: 1rem; border-radius: 4px; overflow-x: auto; }
  body
    .container
      block content
